# Copy to .env and fill in. Never commit .env.

# Needed only for phase 4 (the LLM arm) and notebooks that call
# smart_spatial_system's LLMQuerySpecGenerator or LLM-backed /query path.
# Everything else in this repository (data prep, the rule-based arm, the
# comparison metric, plotting) needs none of this.
#
# smart_spatial_system's OpenAICompatibleLLMClient checks these in this
# exact order and uses the first one set - fill in whichever matches your
# provider, no need to set all three (order confirmed from
# orchestrator/planning/llm_spec_generator.py, 2026-09-12):
LLM_API_KEY=
AVALAI_API_KEY=
OPENAI_API_KEY=

# Only needed for AvalAI or another OpenAI-compatible endpoint that isn't
# api.openai.com. NOTE: the variable name is LLM_BASE_URL, not
# OPENAI_BASE_URL - confirmed from source (an earlier version of this
# file had the wrong name, which the client would have silently ignored,
# falling back to its own default - happened to be the same AvalAI URL,
# so it never actually broke anything, but fix it anyway):
LLM_BASE_URL=https://api.avalai.ir/v1

LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.1
